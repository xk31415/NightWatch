{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "_说明": "复制本文件为 appsettings.json 后填入真实值。appsettings.json 已被 .gitignore 排除，请勿将真实凭据提交入库。",

  "WatchDog": {
    // 监控/告警时段：不写 = 24 小时生效。NoAlert = 时段外继续监控与拉起、只静默告警；
    // Off = 时段外完全停止检查。单条规则里也可各写自己的 Schedule 覆盖全局。
    // "Schedule": {
    //   "Mode": "NoAlert",
    //   "Windows": [
    //     { "Days": ["Mon", "Tue", "Wed", "Thu", "Fri"], "Start": "08:30", "End": "18:30" },
    //     { "Days": ["Sat"], "Start": "09:00", "End": "12:00" }
    //   ]
    // },

    "Notify": {
      "Channels": [
        {
          "Type": "wecom",
          "Name": "企业微信群",
          "WebhookUrl": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<你的机器人key>"
        },
        {
          "Type": "dingtalk",
          "Name": "钉钉群",
          "WebhookUrl": "https://oapi.dingtalk.com/robot/send?access_token=<你的access_token>",
          "Secret": "SEC<加签密钥，机器人安全设置选加签时必填>"
        },
        {
          "Type": "email",
          "Name": "QQ邮箱告警",
          "SmtpHost": "smtp.qq.com",
          "SmtpPort": 587,
          "UseSsl": false,
          "Username": "your@qq.com",
          "Password": "<SMTP授权码，不是登录密码>",
          "From": "your@qq.com",
          "To": [ "receiver@qq.com" ]
        }
      ]
    },

    "EnableStartupSecurityCheck": false, // 文件里的 false 在配置可写时无效。关闭请用环境变量 WatchDog__EnableStartupSecurityCheck=false

    "Processes": [
      {
        "Name": "示例-进程守护",
        "ProcessName": "myapp",
        "FilePath": "D:\\apps\\myapp\\myapp.exe",
        "Arguments": "",
        "WorkingDirectory": "",
        "IntervalSeconds": 30,
        "CooldownMinutes": 10,
        "RestartIfNotResponding": false
      }
    ],

    "Services": [
      {
        "Name": "示例-服务守护",
        "ServiceName": "MyService",
        "AutoRestart": true,
        "AllowLaunch": true, // 安全自检失败时会被关掉；false 时只告警不启动
        "IntervalSeconds": 60,
        "CooldownMinutes": 10
      }
    ],

    "Files": [
      {
        "Name": "示例-日志停更检查",
        "Path": "D:\\logs\\myapp",
        "Pattern": "*.log",
        "StaleMinutes": 10,
        "MaxSizeMB": 500,
        "IntervalSeconds": 60,
        "CooldownMinutes": 30
      }
    ],

    "FileHeartbeats": [
      {
        "Name": "示例-文件心跳",
        "HeartbeatFile": "D:\\data\\heartbeat.txt",
        "StaleMinutes": 5,
        "ProcessName": "myapp",
        "FilePath": "D:\\apps\\myapp\\myapp.exe",
        "Arguments": "",
        "IntervalSeconds": 60,
        "CooldownMinutes": 10
      }
    ],

    "HttpHeartbeat": {
      "Enabled": true,
      "Host": "localhost",          // 默认仅本机。接收其他机器心跳时改为 0.0.0.0 并务必配置 Token（未配 Token 会拒绝对外监听）
      "Port": 5200,
      "Token": "<访问令牌，客户端请求需携带；留空则不鉴权>",
      "StaleMinutes": 5,
      "IntervalSeconds": 60,
      "CooldownMinutes": 10,
      "RetentionMinutes": 60,
      "MaxKeys": 10000,             // 动态键上限，满后拒绝新键（429），0 = 不限制
      "Expected": [],
      "Products": [
        { "Name": "MyApp", "StaleMinutes": 2 }
      ]
    },

    "Resources": {
      "IntervalSeconds": 60,
      "CooldownMinutes": 30,
      "CpuPercent": 90,
      "MemoryPercent": 90,
      "Disks": [
        { "Drive": "C:", "MinFreeGB": 10 }
      ]
    }
  }
}
